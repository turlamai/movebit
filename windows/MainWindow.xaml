<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 2026-11-15 tokens: window #F8F7F3, ink #26241F/#655F55, accent
         #A7472C. The four in-window segments (今日/历史/设置/关于) keep every
         named element of the former card layout; pages stay realized so
         each keeps its scroll position while hidden. -->
    <ScrollViewer Background="#F8F7F3">
        <StackPanel Orientation="Vertical">
            <Grid Padding="20,14,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <InfoBar Grid.Column="0"
                         x:Name="StatusBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="Starting embedded Racket CS…" />
            </Grid>

            <!-- segment tabs: 今日 / 历史 / 设置 / 关于 -->
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="20,10,20,0">
                <ToggleButton x:Name="SegToday" Content="Today"
                              IsChecked="True" Click="Segment_Click" />
                <ToggleButton x:Name="SegHistory" Content="History"
                              Click="Segment_Click" />
                <ToggleButton x:Name="SegSettings" Content="Settings"
                              Click="Segment_Click" />
                <ToggleButton x:Name="SegAbout" Content="About"
                              Click="Segment_Click" />
            </StackPanel>

            <Grid x:Name="SegmentHost">

            <!-- 今日 -->
            <StackPanel x:Name="PageToday" Orientation="Vertical" Spacing="14"
                        Margin="20,14,20,0">
                <Border Background="#FFFFFF" BorderBrush="#EAE2D6"
                        BorderThickness="1" CornerRadius="16"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       x:Name="TodayTitle"
                                       Text="Today"
                                       FontSize="13"
                                       Foreground="#655F55" />
                            <!-- The running/paused indicator is the
                                 control: click to pause 1 h, click the
                                 paused state to resume. -->
                            <Button Grid.Column="1" x:Name="StatusButton"
                                    Click="Status_Click"
                                    Background="Transparent"
                                    BorderThickness="0" Padding="8,3,8,3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border x:Name="StatusDot"
                                            Width="8" Height="8"
                                            CornerRadius="4,4,4,4"
                                            Background="#267344"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="TodayStatus"
                                               Text="—"
                                               FontSize="12.5"
                                               Foreground="#267344" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="TodayDuration" Text="0m"
                                   FontSize="44" FontWeight="Bold"
                                   Foreground="#26241F" />
                        <ProgressBar x:Name="SitBar" Minimum="0" Maximum="1"
                                     Value="0" Height="9"
                                     Foreground="#A7472C"
                                     Background="#EAE3D7"
                                     CornerRadius="4,4,4,4" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="SitCycleText" Text="—"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#26241F" />
                                <TextBlock x:Name="SitCycleCaption"
                                           Text="Sit cycle"
                                           FontSize="11"
                                           Foreground="#655F55" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🚶" FontSize="14" />
                                    <TextBlock x:Name="TodaySit" Text="0"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                                <TextBlock x:Name="TodaySitCaption"
                                           Text="Sit" FontSize="11"
                                           Foreground="#655F55" />
                                <TextBlock x:Name="DoneSit" Text=""
                                           FontSize="10.5"
                                           Foreground="#8B857A" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="💧" FontSize="14" />
                                    <TextBlock x:Name="TodayWater" Text="0"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                                <TextBlock x:Name="TodayWaterCaption"
                                           Text="Water" FontSize="11"
                                           Foreground="#655F55" />
                                <TextBlock x:Name="DoneWater" Text=""
                                           FontSize="10.5"
                                           Foreground="#8B857A" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="👀" FontSize="14" />
                                    <TextBlock x:Name="TodayMicro" Text="0"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                                <TextBlock x:Name="TodayMicroCaption"
                                           Text="Micro" FontSize="11"
                                           Foreground="#655F55" />
                                <TextBlock x:Name="DoneMicro" Text=""
                                           FontSize="10.5"
                                           Foreground="#8B857A" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TodayNextCue" Text=""
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#A7472C" TextWrapping="Wrap" />
                        <TextBlock x:Name="TodayCountsNote" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#655F55" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 历史 -->
            <StackPanel x:Name="PageHistory" Orientation="Vertical" Spacing="14"
                        Margin="20,14,20,0" Visibility="Collapsed">
                <Border Background="#FFFFFF" BorderBrush="#EAE2D6"
                        BorderThickness="1" CornerRadius="16"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="HistTitle" Text="Last 7 days"
                                           FontSize="13"
                                           Foreground="#655F55" />
                                <TextBlock x:Name="HistTotal" Text=""
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#26241F" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      x:Name="HistRange"
                                      SelectionChanged="HistRange_SelectionChanged">
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="30" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="HistChartBars" Spacing="0"
                                    MinHeight="150" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#EAE2D6"
                        BorderThickness="1" CornerRadius="16"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="InsightTitleLabel" Text="Insights"
                                   FontSize="13" Foreground="#655F55" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#EAE3D7"
                                    CornerRadius="12" Padding="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="InsightCurrentTitle"
                                               Text="Current" FontSize="11"
                                               Foreground="#8B857A" />
                                    <TextBlock x:Name="InsightCurrent" Text="0m"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="#EAE3D7"
                                    CornerRadius="12" Padding="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="InsightTodayLongestTitle"
                                               Text="Today longest" FontSize="11"
                                               Foreground="#8B857A" />
                                    <TextBlock x:Name="InsightTodayLongest" Text="0m"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#EAE3D7"
                                    CornerRadius="12" Padding="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="InsightRecentLongestTitle"
                                               Text="Recent longest" FontSize="11"
                                               Foreground="#8B857A" />
                                    <TextBlock x:Name="InsightRecentLongest" Text="0m"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="#EAE3D7"
                                    CornerRadius="12" Padding="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="InsightRecentAvgTitle"
                                               Text="Recent average" FontSize="11"
                                               Foreground="#8B857A" />
                                    <TextBlock x:Name="InsightRecentAvg" Text="0m"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="#26241F" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="InsightBusiestLabel"
                                       Text="Busiest" FontSize="11.5"
                                       Foreground="#8B857A" />
                            <TextBlock x:Name="InsightBusiest" Text=""
                                       FontSize="11.5"
                                       Foreground="#26241F" />
                        </StackPanel>
                        <TextBlock x:Name="InsightSedentary" Text=""
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="#655F55" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 设置 -->
            <StackPanel x:Name="PageSettings" Orientation="Vertical" Spacing="14"
                        Margin="20,14,20,0" Visibility="Collapsed">
                <Border Background="#FFFFFF" BorderBrush="#EAE2D6"
                        BorderThickness="1" CornerRadius="16"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SettingsTitle"
                                       Text="Settings" FontSize="13"
                                       Foreground="#655F55" />
                            <TextBlock Grid.Column="1" x:Name="ConfigStatus"
                                       Text="" FontSize="11.5"
                                       Foreground="#A7472C"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock x:Name="SettingsIntro" Text=""
                                   FontSize="11" Foreground="#8B857A"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="NextCueText" Text=""
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#A7472C" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SetSoundLabel"
                                       Text="Sound" FontSize="13"
                                       Foreground="#26241F" />
                            <ToggleSwitch Grid.Column="1" x:Name="SoundSwitch"
                                          MinWidth="0" HorizontalAlignment="Right"
                                          OnContent="" OffContent=""
                                          Toggled="Sound_Toggled" />
                        </Grid>
                        <TextBlock x:Name="SetSoundHint" Text=""
                                   FontSize="11" Foreground="#8B857A"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SetQuietHoursLabel"
                                       Text="Quiet hours" FontSize="13"
                                       Foreground="#26241F" />
                            <ToggleSwitch Grid.Column="1" x:Name="QuietHoursSwitch"
                                          MinWidth="0" HorizontalAlignment="Right"
                                          OnContent="" OffContent=""
                                          Toggled="QuietHours_Toggled" />
                        </Grid>
                        <TextBlock x:Name="SetQuietHoursHint" Text=""
                                   FontSize="11" Foreground="#8B857A"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="QuietHoursPanel" Spacing="8"
                                    Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="SetQuietStartLabel"
                                           Text="From" FontSize="13"
                                           Foreground="#26241F" />
                                <NumberBox Grid.Column="1" x:Name="QuietStartBox"
                                           Minimum="0" Maximum="23" SmallChange="1"
                                           Value="22" SpinButtonPlacementMode="Compact"
                                           Width="96"
                                           ValueChanged="QuietStart_ValueChanged" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="SetQuietEndLabel"
                                           Text="To" FontSize="13"
                                           Foreground="#26241F" />
                                <NumberBox Grid.Column="1" x:Name="QuietEndBox"
                                           Minimum="0" Maximum="23" SmallChange="1"
                                           Value="7" SpinButtonPlacementMode="Compact"
                                           Width="96"
                                           ValueChanged="QuietEnd_ValueChanged" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SetAutostartLabel"
                                       Text="Launch at login" FontSize="13"
                                       Foreground="#26241F" />
                            <ToggleSwitch Grid.Column="1" x:Name="AutostartSwitch"
                                          MinWidth="0" HorizontalAlignment="Right"
                                          OnContent="" OffContent=""
                                          Toggled="Autostart_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SetLanguageLabel"
                                       Text="Language" FontSize="13"
                                       Foreground="#26241F" />
                            <ComboBox Grid.Column="1" x:Name="LanguageDrop"
                                      Width="132" HorizontalAlignment="Right"
                                      SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel x:Name="PageAbout" Orientation="Vertical" Spacing="14"
                        Margin="20,14,20,0" Visibility="Collapsed">
                <Border Background="#FFFFFF" BorderBrush="#EAE2D6"
                        BorderThickness="1" CornerRadius="16"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="AboutVersion" Text="MoveBit"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#26241F" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="AboutUpdateLabel"
                                           Text="Check for updates" FontSize="13"
                                           Foreground="#26241F" />
                                <TextBlock x:Name="AboutUpdateHint"
                                           Text="" FontSize="11"
                                           Foreground="#8B857A" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="UpdatesSwitch"
                                          MinWidth="0" HorizontalAlignment="Right"
                                          OnContent="" OffContent=""
                                          Toggled="Updates_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="AboutCheckLabel"
                                           Text="Check for updates" FontSize="13"
                                           Foreground="#26241F" />
                                <TextBlock x:Name="AboutCheckHint"
                                           Text="" FontSize="11"
                                           Foreground="#8B857A"
                                           TextWrapping="Wrap" />
                                <Button x:Name="UpdateCopyErrorButton"
                                        Click="UpdateCopyError_Click"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Left"
                                        Padding="8,2,8,2" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Spacing="4">
                                <Button x:Name="UpdateCheckButton"
                                        Click="UpdateCheck_Click" />
                                <Button x:Name="UpdateCancelButton"
                                        Click="UpdateCancel_Click"
                                        Visibility="Collapsed"
                                        Padding="8,2,8,2" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <HyperlinkButton x:Name="WebsiteLink"
                                                 NavigateUri="https://movebit.jrtx.site"
                                                 Foreground="#A7472C"
                                                 Padding="0" FontSize="12" />
                                <HyperlinkButton x:Name="IssueLink"
                                                 NavigateUri="https://github.com/turlamai/movebit/issues"
                                                 Foreground="#A7472C"
                                                 Padding="0" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="AboutLicenseText"
                                       Text="" FontSize="11"
                                       Foreground="#8B857A" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="DataFolderLabel"
                                           Text="Data folder" FontSize="13"
                                           Foreground="#26241F" />
                                <TextBlock x:Name="DataFolderValue"
                                           Text="" FontSize="11"
                                           Foreground="#8B857A"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DataFolderHint"
                                           Text="" FontSize="11"
                                           Foreground="#8B857A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="DataFolderButton"
                                    VerticalAlignment="Center"
                                    Click="ChangeDataDir_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FooterText" Text="" FontSize="11"
                           Foreground="#8B857A" TextWrapping="Wrap" />
            </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
