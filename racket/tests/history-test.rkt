#lang racket/base

(require rackunit db json racket/file racket/list racket/string
         "../movebit/history.rkt" "../movebit/config.rkt" "../movebit/storage.rkt"
         "../movebit/paths.rkt" "../movebit/timeutil.rkt")
(define today (ms->date-key (now-ms)))
(define (temp) (make-temporary-file "movebit-sqlite-~a" 'directory))
(define (record n [longest n]) (day-record n n n n longest (hasheq 'water (hasheq 'presented n))))
(define (count-today store)
  (day-record-active-minutes (cdr (car (history-get-recent store 1 today)))))
(define (shard root day device) (build-path root "history" day (string-append device ".json")))
(define (write-json-file path js)
  (call-with-output-file path (lambda (out) (write-json js out)) #:exists 'replace))
(define (envelope day device revision r)
  (hasheq 'SchemaVersion 1 'Date day 'DeviceId device 'Revision revision 'Record (day-record->jsexpr r)))
(define (with-pair proc)
  (define root (temp))
  (dynamic-wind void
    (lambda ()
      (define sync (build-path root "exchange"))
      (define a (make-history-store (build-path root "a") "aaaaaaaa" #:sync-dir sync))
      (define b (make-history-store (build-path root "b") "bbbbbbbb" #:sync-dir sync))
      (history-load! a) (history-load! b)
      (proc a b sync root))
    (lambda () (delete-directory/files root))))

(test-case "SQLite is the durable source; config and history share one local database"
  (define root (temp))
  (define s (make-history-store root "aaaaaaaa"))
  (history-load! s)
  (save-config root (struct-copy reminder-config (default-config) [language "zh"]))
  (history-save-day! s today (record 42))
  (check-false (directory-exists? (build-path root "history")))
  (check-false (file-exists? (build-path root "history.json")))
  (define restored (history-load! (make-history-store root "aaaaaaaa")))
  (check-equal? (count-today restored) 42)
  (check-equal? (reminder-config-language (load-config root)) "zh")
  (call-with-store root (lambda (db)
    (check-equal? (query-value db "SELECT active FROM records WHERE day = ?" today) 42)))
  (check-equal? (length (history-get-recent restored 7 today)) 7)
  (check-equal? (day-record-active-minutes (cdr (car (history-get-recent restored 7 today)))) 0)
  (check-equal? (history-get-recent restored 0 today) '())
  (history-observe-longest-session! restored today 80)
  (history-save-day! restored today (record 43 20))
  (check-equal? (day-record-longest-session-minutes (history-device-record restored today)) 80)
  (delete-directory/files root))

(test-case "two independent databases merge snapshots without double counting"
  (with-pair (lambda (a b sync root)
    (history-save-day! a today (record 120 45))
    (history-save-day! b today (record 60 70))
    (history-refresh! b)
    (check-equal? (count-today b) 180)
    (check-equal? (day-record-longest-session-minutes (cdr (car (history-get-recent b 1 today)))) 70)
    (check-equal? (day-record-active-minutes (history-device-record b today)) 60)
    (check-equal? (history-device-ids b today) '("aaaaaaaa" "bbbbbbbb"))
    (for ([_ (in-range 3)]) (history-refresh! b))
    (check-equal? (count-today b) 180)
    (check-equal? (cue-outcome-count (day-record-cue-outcomes (cdr (car (history-get-recent b 1 today)))) 'water 'presented) 180)
    (check-equal? (sort (map path->string (directory-list (build-path sync "history" today))) string<?)
                  '("aaaaaaaa.json" "bbbbbbbb.json"))
    (check-false (file-exists? (build-path sync "movebit.sqlite3")))
    (check-false (file-exists? (build-path sync "config.json")))
    ;; Removing transport entirely cannot remove committed local history.
    (delete-directory/files sync)
    (define restored (history-load! (make-history-store (build-path root "b") "bbbbbbbb")))
    (check-equal? (count-today restored) 180))))

(test-case "stale and conflicting arrivals do not rewind a record; own export repairs itself"
  (with-pair (lambda (a b sync root)
    (history-save-day! a today (record 10))
    (define path (shard sync today "aaaaaaaa"))
    (define old (call-with-input-file path read-json))
    (history-refresh! b)
    (history-save-day! a today (record 30))
    (define latest (call-with-input-file path read-json))
    (check-equal? (hash-ref latest 'Revision) 2)
    (history-refresh! b)
    (write-json-file path old)
    (history-refresh! b)
    (check-equal? (count-today b) 30)
    (write-json-file path (hash-set latest 'Record (day-record->jsexpr (record 999))))
    (history-refresh! b)
    (check-equal? (count-today b) 30)
    (history-refresh! a)
    (check-equal? (call-with-input-file path read-json) latest)
    (history-save-day! a today (record 15))
    (check-equal? (call-with-input-file path read-json) latest)
    ;; Same-second file replacement must be read; filesystem mtime is not identity.
    (write-json-file path (envelope today "aaaaaaaa" 3 (record 40)))
    (history-refresh! b)
    (check-equal? (count-today b) 40))))

(test-case "malformed/foreign records, aliases and symlinks cannot poison SQLite"
  (with-pair (lambda (a b sync root)
    (history-save-day! a today (record 10))
    (history-refresh! b)
    (define path (shard sync today "aaaaaaaa"))
    (define good (envelope today "aaaaaaaa" 2 (record 999)))
    (for ([bad (list (hash-set good 'SchemaVersion 2)
                     (hash-set good 'DeviceId "cccccccc")
                     (hash-set good 'Date "2026-02-31")
                     (hash-set good 'Revision -1)
                     (hash-set good 'Record (hasheq))
                     (hash-set good 'Record (hash-set (day-record->jsexpr (record 999)) 'ActiveMinutes -1)))])
      (write-json-file path bad)
      (history-refresh! b)
      (check-equal? (count-today b) 10))
    (display-to-file (make-string 70000 #\x) path #:exists 'replace)
    (history-refresh! b) (check-equal? (count-today b) 10)
    (write-json-file path good)
    (copy-file path (build-path sync "history" today "cccccccc.json.sync-conflict.json"))
    (delete-file path)
    (make-file-or-directory-link (build-path sync "history" today "cccccccc.json.sync-conflict.json") path)
    (history-refresh! b) (check-equal? (count-today b) 10)
    (check-exn exn:fail? (lambda () (history-save-day! b "../../outside" (record 1))))
    (check-exn exn:fail? (lambda () (make-history-store (build-path root "local") "aaaaaaaa" #:sync-dir root))))))

(test-case "failed exchange retries from committed SQLite after a restart"
  (define root (temp))
  (define local (build-path root "local"))
  (define sync (build-path root "exchange"))
  (display-to-file "unavailable mount" sync)
  (define s (make-history-store local "aaaaaaaa" #:sync-dir sync))
  (history-load! s)
  (check-not-exn (lambda () (history-save-day! s today (record 42))))
  (check-equal? (count-today s) 42)
  (delete-file sync)
  (define restored (history-load! (make-history-store local "aaaaaaaa" #:sync-dir sync)))
  (check-equal? (count-today restored) 42)
  (check-equal? (hash-ref (call-with-input-file (shard sync today "aaaaaaaa") read-json) 'Revision) 1)
  (delete-directory/files root))

(test-case "retention is durable and old sync arrivals cannot resurrect records"
  (with-pair (lambda (a b sync root)
    (define expired (date-key+days today (- retention-days)))
    (define oldest (date-key+days today (- (sub1 retention-days))))
    (history-save-day! a oldest (record 7) today)
    (history-save-day! a expired (record 999) today)
    (check-equal? (hash-count (history-days a)) 1)
    (define dir (build-path sync "history" expired))
    (make-directory* dir)
    (write-json-file (shard sync expired "bbbbbbbb") (envelope expired "bbbbbbbb" 99 (record 999)))
    (history-refresh! a)
    (check-equal? (hash-count (history-days a)) 1)
    (check-true (file-exists? (shard sync expired "bbbbbbbb")))
    (define restored (history-load! (make-history-store (build-path root "a") "aaaaaaaa" #:sync-dir sync)))
    (check-equal? (hash-count (history-days restored)) 1))))

(test-case "concurrent instances commit one monotone row, without partial snapshots"
  (define root (temp))
  (define a (make-history-store root "aaaaaaaa"))
  (define b (make-history-store root "aaaaaaaa"))
  (history-load! a) (history-load! b)
  (define errors (make-channel))
  (define (writer store start)
    (thread (lambda () (with-handlers ([exn:fail? (lambda (e) (channel-put errors e))])
      (for ([i (in-range start (+ start 10))]) (history-save-day! store today (record i)))))))
  (define one (writer a 1)) (define two (writer b 30))
  (define failed (sync/timeout 20 errors (thread-dead-evt one)))
  (when (exn? failed) (raise failed))
  (check-not-false (sync/timeout 20 (thread-dead-evt two)))
  (history-refresh! a)
  (check-equal? (count-today a) 39)
  (call-with-store root (lambda (db)
    (check-equal? (query-value db "SELECT count(*) FROM records") 1)
    (check-equal? (query-value db "PRAGMA integrity_check") "ok")))
  (delete-directory/files root))

(test-case "retired single-file JSON history is not a parallel store or migration path"
  (define root (temp))
  (define path (build-path root "history.json"))
  (write-json-file path (hasheq (string->symbol today) (day-record->jsexpr (record 999))))
  (define s (history-load! (make-history-store root "aaaaaaaa")))
  (check-equal? (count-today s) 0)
  (check-true (file-exists? path))
  (check-false (file-exists? (build-path root "history.json.migrated")))
  (delete-directory/files root))

(test-case "unavailable database preserves cached history and does not replace foreign bytes"
  (define dir (temp))
  (define s (history-load! (make-history-store dir "aaaaaaaa")))
  (history-save-day! s today (record 42))
  (define path (database-path dir))
  (delete-file path)
  (display-to-file "foreign database contents" path)
  (check-not-exn (lambda () (history-refresh! s)))
  (check-equal? (count-today s) 42)
  (check-exn exn:fail? (lambda () (history-save-day! s today (record 50))))
  (check-equal? (file->string path) "foreign database contents")
  (check-equal? (count-today s) 42)
  (check-not-exn (lambda () (history-load! (make-history-store dir "aaaaaaaa"))))
  (delete-directory/files dir))

(test-case "directory aliases cannot put the live database inside record exchange"
  (define root (temp))
  (define local (build-path root "local"))
  (define alias (build-path root "alias"))
  (make-file-or-directory-link root alias)
  (check-exn exn:fail?
    (lambda () (make-history-store local "aaaaaaaa" #:sync-dir alias)))
  (delete-directory/files root))

(test-case "export does not follow a history-directory symlink or leak local settings"
  (define root (temp))
  (define local (build-path root "local"))
  (define exchange (build-path root "exchange"))
  (define outside (build-path root "outside"))
  (make-directory* exchange) (make-directory* outside)
  (make-file-or-directory-link outside (build-path exchange "history"))
  (define s (make-history-store local "aaaaaaaa" #:sync-dir exchange))
  (history-load! s)
  (history-save-day! s today (record 10))
  (check-equal? (directory-list outside) '())
  (delete-file (build-path exchange "history"))
  (save-config local (struct-copy reminder-config (default-config) [language "zh"] [welcome-shown #t]))
  (history-refresh! s)
  (define emitted (file->string (shard exchange today "aaaaaaaa")))
  (for ([forbidden '("SQLite format" "Language" "WelcomeShown" "SoundEnabled" "local-data-dir" "sync-dir")])
    (check-false (string-contains? emitted forbidden)))
  (define js (string->jsexpr emitted))
  (check-equal? (sort (hash-keys js) symbol<?) '(Date DeviceId Record Revision SchemaVersion))
  (delete-directory/files root))

(test-case "a rejected SQLite transaction cannot publish uncommitted counters"
  (with-pair (lambda (a b sync root)
    (history-save-day! a today (record 42))
    (define original (file->bytes (shard sync today "aaaaaaaa")))
    (call-with-store (build-path root "a") (lambda (db)
      (query-exec db "CREATE TRIGGER reject_record BEFORE UPDATE ON records BEGIN SELECT RAISE(ABORT, 'injected storage failure'); END")))
    (check-exn exn:fail? (lambda () (history-save-day! a today (record 50))))
    (check-equal? (count-today a) 42)
    (check-equal? (file->bytes (shard sync today "aaaaaaaa")) original)
    (call-with-store (build-path root "a") (lambda (db)
      (check-equal? (query-row db "SELECT active, revision FROM records") (vector 42 1))
      (query-exec db "DROP TRIGGER reject_record")))
    (history-save-day! a today (record 50))
    (history-refresh! b)
    (check-equal? (count-today b) 50))))

(test-case "storage diagnostics use the injected sink without writing stderr"
  (define dir (temp))
  (display-to-file "unreadable SQLite" (database-path dir))
  (define messages '())
  (define err (open-output-string))
  (parameterize ([current-error-port err]
                 [current-history-diagnostic (lambda (message) (set! messages (cons message messages)))])
    (history-load! (make-history-store dir "aaaaaaaa")))
  (check-equal? (get-output-string err) "")
  (check-equal? (length messages) 1)
  (delete-directory/files dir))
